# App
APP_BASE_URL=https://yourdomain.com

# Port for the server
PORT=5173

# Database dialect and connection string
# "postgresql" | "mysql" | "sqlite" | "turso" | "singlestore" | "gel"
DATABASE_DIALECT=postgresql

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibroker

# Session secret (generate a strong random string for production)
SESSION_SECRET=change-me-to-a-long-random-string

# Session TTL duration (supports m/h/d/y, e.g. 90m, 12h, 30d, 1y)
SESSION_TTL=1h

# Refresh-token TTL duration (supports m/h/d/y, e.g. 12h, 7d, 30d)
REFRESH_TOKEN_TTL=30d

# MFA break-glass link expiry in minutes (very short-lived)
MFA_BREAK_GLASS_EXPIRY_MINUTES=10

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Master key secret used for encrypting/decrypting user Api Keys.
MASTER_KEY_SECRET=change-me-to-a-long-random-string

# Max concurrent upstream LLM requests (global limit)
MAX_CONCURRENT_UPSTREAM=32

# Default admin bootstrap (only used if no user exists yet)
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=admin

# User Create/Invite expiry
INVITE_EXPIRY_HOURS=72        # optional, defaults to 72

# Mailgun settings
MAILGUN_API_KEY=...
MAILGUN_DOMAIN=...
MAILGUN_FROM_EMAIL=...


