{
  "name": "aibroker",
  "version": "0.1.0",
  "description": "OpenAI-compatible LLM proxy with dashboard, virtual keys, budgets, guardrails, MCP and skills.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "build:docker:image": "docker build -t aibroker:latest .",
    "build:docker": "npm run build && npm run build:docker:image",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:smoke": "pnpm tsx test/smoke/smoke-test.ts",
    "prebuild": "pnpm run check && pnpm run test:unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/server/db/migrate.ts",
    "db:seed": "tsx src/lib/server/db/seed.ts",
    "db:purge": "bun run ./cli/index.ts db-purge",
    "ngrok": "npx ngrok http 4000",
    "hash-pass": "bun run ./cli/index.ts hash-pass",
    "verify-pass": "bun run ./cli/index.ts verify-pass",
    "get-models": "bun run ./cli/index.ts get-models",
    "break-glass": "bun run ./cli/index.ts break-glass",
    "postgres-run": "bun run ./cli/index.ts postgres-run",
    "postgres-stop": "bun run ./cli/index.ts postgres-stop",
    "postgres-rm": "bun run ./cli/index.ts postgres-rm",
    "aibroker-run": "bun run ./cli/index.ts aibroker-run",
    "aibroker-stop": "bun run ./cli/index.ts aibroker-stop",
    "aibroker-rm": "bun run ./cli/index.ts aibroker-rm",
    "docker-prune-vol": "bun run ./cli/index.ts docker-prune-vol",
    "show-help": "bun run ./cli/index.ts help"
  },
  "dependencies": {
    "@lucide/svelte": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@node-rs/argon2": "^2.0.2",
    "arctic": "^3.7.0",
    "bits-ui": "^1.3.2",
    "chalk": "^5.6.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "layerchart": "^1.0.0",
    "mode-watcher": "^1.1.0",
    "nanoid": "^5.0.9",
    "otplib": "^12.0.1",
    "p-limit": "^6.2.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.11",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.19.17",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clipboardy": "^5.3.1",
    "drizzle-kit": "^0.31.10",
    "slashes": "^3.0.12",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "table": "^6.9.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}