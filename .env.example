# Port for the server
PORT=5173

# SQLite database dialect and path
DATABASE_DIALECT=sqlite
DATABASE_URL=file:./data/aibroker.db

# Session secret (generate a strong random string for production)
SESSION_SECRET=change-me-to-a-long-random-string

# Master key secret used for encrypting/decrypting user Api Keys.
MASTER_KEY_SECRET=change-me-to-a-long-random-string

# Max concurrent upstream LLM requests (global limit)
MAX_CONCURRENT_UPSTREAM=32

# Default admin bootstrap (only used if no user exists yet)
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=admin
