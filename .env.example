# --------------------------------------------------- #
# Required Variables
# --------------------------------------------------- #

# Development Variables:  
#     MASTER_KEY_SECRET
#     SESSION_SECRET

# Production Variables: 
#     MASTER_KEY_SECRET
#     SESSION_SECRET

# Required for sending sign up links etc.
#     MAILGUN_BASE_URL= # optional, https://yourdomain.com 
#     MAILGUN_API_KEY= # 1234793cbadee-7939j-01458136
#     MAILGUN_DOMAIN= # mg.yourdomain.com
#     MAILGUN_FROM_EMAIL= # no-reply@yourdomain.com

# Required for Google Sign On
#     GOOGLE_CLIENT_ID= # optional, Google login disabled if config blank.
#     GOOGLE_CLIENT_SECRET=
#     GOOGLE_OAUTH_REDIRECT_URI= # optional, http://yourdomain.com/auth/google/callback

# --------------------------------------------------- #
# Application
# --------------------------------------------------- #

PORT= # optional, port to listen on - default 4000

MASTER_KEY_SECRET= # used to encrypt/decrypt api keys.

BOOTSTRAP_ADMIN_EMAIL= # optional used once if present, otherwise setup shown
BOOTSTRAP_ADMIN_PASSWORD= # optional, used only if present

DATABASE_CONNECTION_URL= # optional - default postgresql://postgres:postgres@localhost:5432/aibroker
DATABASE_POOL_MAX= # optional - default -10
DATABASE_IDLE_TIMEOUT_SEC= # optional - default 20
DATABASE_CONNECT_TIMEOUT_SEC= # optional - default 10

# Log Levels, default 'WARNING': 'PANIC', 'FATAL', 'ERROR', 'WARNING', 'NOTICE', 'INFO', 'LOG', 'DEBUG1', 'DEBUG2', 'DEBUG3', 'DEBUG4', 'DEBUG5'
DATABASE_LOG_LEVEL= # optional - Default "WARNING"

SCOPE_OBSERVABILITY_LOGS= # optional, observability, 0 to disable - default 1
LOG_LEVEL= # optional, logger level: debug | info | warn | error
LOG_REDACT_SENSITIVE= # optional, 1 to redact sensitive fields (default), 0 to disable redaction
ALLOW_DB_PURGE= # optional safety switch for CLI purge helper; must be 1 with NODE_ENV=development

# --------------------------------------------------- #
# Upstream/Proxy Tunning
# --------------------------------------------------- #

MAX_CONCURRENT_PER_BACKEND= # optional - default 16
UPSTREAM_TIMEOUT_MS=# optional - default 60000
UPSTREAM_STREAM_TIMEOUT_MS= # optional - default 300000
AUTH_CACHE_TTL_MS= # optional - default 30000
BUDGET_CACHE_TTL_MS= # optional - default 5000

# --------------------------------------------------- #
# Auth, Session & Expiry
# --------------------------------------------------- #

SESSION_SECRET= # strong secret for sessions.
SESSION_TTL= # optional, duration (m/h/d/y, e.g. 90m, 12h, 30d, 1y) - default 1d
REFRESH_TOKEN_TTL= # optional, duration (m/h/d/y, e.g. 12h, 7d, 30d) - default 30d
MFA_BREAK_GLASS_EXPIRY_MINUTES= # optional, link expiry in minutes - default 10
INVITE_EXPIRY_HOURS= # optional, create/invite expiry - default 72
PASSWORD_RESET_EXPIRY_HOURS= # optional - default 1 hour.

# --------------------------------------------------- #
# Third Party Variables
# --------------------------------------------------- #

MAILGUN_BASE_URL= # optional, https://yourdomain.com 
MAILGUN_API_KEY= # 1234793cbadee-7939j-01458136
MAILGUN_DOMAIN= # mg.yourdomain.com
MAILGUN_FROM_EMAIL= # ex: no-reply@yourdomain.com

GOOGLE_CLIENT_ID= # optional, Google login disabled if config blank.
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI= # optional, http://yourdomain.com/auth/google/callback

# --------------------------------------------------- #
# CLI Helpers
# --------------------------------------------------- #

PASSWORD_PEPPER= # optional extra pepper for CLI hash/verify helpers.